{{- if eq .os "omarchy" -}}
# If not running interactively, don't do anything (leave this at the top of this file)
[[ $- != *i* ]] && return

# All the default Omarchy aliases and functions
# (don't mess with these directly, just overwrite them here!)
source ~/.local/share/omarchy/default/bash/rc
{{ end -}}

{{- if .personal }}
# Opens the game in editor and connects nvim
unset -f gd # Used by omarchy for deleting worktrees
alias gd='[ -L ./godot ] && (./godot -e > /dev/null 2>&1 & clear && nvim --listen ./godot.pipe) || echo "Need to run: \"ln -sf ~/Godot/4.x ./godot\""'
{{- end }}
