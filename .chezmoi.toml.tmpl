{{- $osChoices := list "omarchy" "ubuntu" "mac" -}}
{{- $email := promptStringOnce . "email" "What is your email address" -}}
{{- $os := promptChoiceOnce . "os" "Which os are you on" $osChoices -}}
{{- $personal := promptBoolOnce . "personal" "Is this a personal machine" -}}

[data]
    email = {{ $email | quote }}
    os = {{ $os | quote }}
    personal = {{ $personal }}

[git]
    autoCommit = true
    autoPush = true
